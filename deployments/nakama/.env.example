# Copy to .env and adjust for your host. docker compose reads this file
# automatically from the directory that contains docker-compose.yml.

# Nakama server version. Must match the pluginbuilder used to build the plugin.
NAKAMA_VERSION=3.41.0

# PostgreSQL
POSTGRES_VERSION=16
POSTGRES_DB=nakama
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdb

# Host ports
NAKAMA_GRPC_PORT=7349
NAKAMA_HTTP_PORT=7350
NAKAMA_CONSOLE_PORT=7351

# Shared secret that out-of-process battle servers present (X-Gensoulkyo-Service-Key
# header or service_key query parameter) to call service-origin RPCs
# (battle.servers.*, battle.agent.assignments, battle.result.submit).
GENSOULKYO_SERVICE_CALLBACK_KEY=defaulthttpkey
